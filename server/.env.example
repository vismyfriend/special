# ============================================================
#  server/.env.example
# ------------------------------------------------------------
#  Скопируй в .env и подставь свои значения:
#    cp .env.example .env
#  .env НЕ коммитится в git (см. server/.gitignore)
# ============================================================

# --- Подключение к PostgreSQL ---
DB_USER=vincentspecial
DB_HOST=localhost
DB_NAME=english_app
DB_PASSWORD=
DB_PORT=5432

# --- JWT ---
# Свой секрет (потом согласовать с Егорчиком для миграции токенов)
JWT_SECRET=change-me-to-a-long-random-string

# --- Сервер ---
PORT=3001
